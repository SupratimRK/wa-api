# EXAMPLE ENVIRONMENT - .env.example
# Copy this file to .env.development and .env.production and fill in the appropriate values


# THE PORT YOUR SERVER WILL RUN ON
PORT="5000"

# API KEY FOR AUTHENTICATING EXTERNAL REQUESTS (CHANGE THIS TO A SECURE VALUE)
API_KEY="your_super_secret_api_key"

# EXTERNAL WEBHOOK URL TO FORWARD INCOMING MESSAGES TO
WEBHOOK_URL="https://your-webhook-url.com/endpoint"

# SECRET KEY TO SIGN WEBHOOK PAYLOADS (CHANGE THIS TO A SECURE VALUE)
WEBHOOK_SECRET="your_super_secret_webhook_signature_key"
